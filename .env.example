# Beam node environment for orchestrator, worker, and validator.

CORE_SERVER_URL=https://beamcore.b1m.ai
BEAM_ENV=prod
SUBTENSOR_NETWORK=finney
NETUID=105

# Orchestrator
BEAM_BITTENSOR_HOTKEY=orchestrator_hotkey_ss58
BEAMCORE_NATS_URL=tls://orch-gateway.b1m.ai:4222
BEAMCORE_NATS_USER=orchestrator_hotkey_ss58
BEAMCORE_NATS_PASSWORD=orchestrator-api-key
BEAMCORE_GATEWAY_URL=https://orchestrator.example.com
BEAM_WCP_LISTEN_ADDR=0.0.0.0:8782
BEAM_WCP_TLS_CERT=/path/to/wcp.crt
BEAM_WCP_TLS_KEY=/path/to/wcp.key
BEAM_ROOM_TUNNEL_COORDINATOR_URL=https://coordinator.b1m.ai

# Worker
BEAM_WORKER_ID=worker-id
BEAM_ORCHESTRATOR_ID=orchestrator-id
BEAM_WCP_ADDRESS=orchestrator.example.com:8782
BEAM_WCP_CA=/path/to/wcp-ca.pem
BEAM_WCP_SERVER_NAME=orchestrator.example.com
BEAM_ORCHESTRATOR_DELEGATION=base64url-delegation

# Validator
BEAM_VALIDATOR_WALLET_NAME=validator
BEAM_VALIDATOR_WALLET_HOTKEY=default
BEAM_VALIDATOR_CORE_SERVER_URL=https://beamcore.b1m.ai
